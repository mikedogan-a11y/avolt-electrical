# ───────────────────────────────────────────────────────────────
#  Copy this file to ".env" and fill in real values.
#  NEVER commit the real .env — it holds your WordPress password.
# ───────────────────────────────────────────────────────────────

# --- WordPress login ---
WP_LOGIN_URL=https://www.mortgagemd.com.au/wp-login.php
# The page that shows the proposal data-entry form (the one your Nepal team opens):
WP_FORM_URL=https://www.mortgagemd.com.au/REPLACE-WITH-PROPOSAL-FORM-PAGE
WP_USERNAME=bR0k3RsuPp0rT
WP_PASSWORD=replace-with-the-password

# --- Who is allowed to trigger the bot ---
# Make up a long random string. Anyone hitting the web page must enter it.
TRIGGER_TOKEN=replace-with-a-long-random-secret

# --- Optional: AI mapping (free-text notes -> structured fields) ---
# Only needed if you want to paste raw notes instead of clean JSON.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Server ---
PORT=3000
# Set to "true" the first time to watch the browser do its thing (local only):
HEADLESS=true
